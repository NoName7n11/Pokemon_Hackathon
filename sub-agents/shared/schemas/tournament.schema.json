{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan_2 central tournament summary",
  "type": "object",
  "required": [
    "schema_version",
    "tournament_id",
    "status",
    "games_per_seat",
    "pairings",
    "total_games",
    "auto_promote",
    "provisional_champion",
    "entrants",
    "ranking",
    "matchup_matrix",
    "matchup_results"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tournament_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "complete_with_engine_errors"] },
    "games_per_seat": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "pairings": { "type": "integer", "minimum": 1 },
    "total_games": { "type": "integer", "minimum": 2 },
    "auto_promote": { "const": false },
    "provisional_champion": { "type": "string", "minLength": 1 },
    "entrants": { "type": "array", "minItems": 2 },
    "ranking": { "type": "array", "minItems": 2 },
    "matchup_matrix": { "type": "object" },
    "progress_comparison": { "type": "object" },
    "matchup_results": { "type": "array", "minItems": 1 }
  }
}
