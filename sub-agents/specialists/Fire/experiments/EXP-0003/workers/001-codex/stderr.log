_CARD_DATA = None
_ATTACK_DATA = None
_MY_DECK = None

# MAIN-phase 1-ply lookahead config.
SEARCH_MAIN = True          # MAIN-phase 1-ply lookahead. MEASURED (Hydrapple deck,
                            # vs frozen greedy): lookahead 64.6% [60.3-68.7] n=500 vs
                            # greedy control 49.0% [43.4-54.6] n=300 => +15.6pts.
